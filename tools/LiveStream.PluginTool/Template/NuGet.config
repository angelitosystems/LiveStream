<?xml version="1.0" encoding="utf-8"?>
<!-- Feed local del SDK instalado: LiveStream.PluginSdk se restaura sin conexión. -->
<configuration>
  <packageSources>
    <add key="livestream-sdk" value="__SDKDIR__" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
