<Project Sdk="Microsoft.NET.Sdk">
  <!-- Instalador por usuario. scripts/package.ps1 lo publica como un único .exe con el paquete de la aplicación
       incrustado (propiedad PayloadZip). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>LiveStream-Setup</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\LiveStream.Desktop\Install\InstallLayout.cs" Link="InstallLayout.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(PayloadZip)' != ''">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" />
  </ItemGroup>
</Project>
