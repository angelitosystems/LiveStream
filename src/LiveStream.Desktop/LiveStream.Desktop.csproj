<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>..\..\Assets\generated\LiveStream.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\..\Assets\generated\LiveStream.ico" Link="Assets\LiveStream.ico" />
    <AvaloniaResource Include="..\..\Assets\generated\logo-512.png" Link="Assets\logo-512.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LiveStream.Application\LiveStream.Application.csproj" />
    <ProjectReference Include="..\LiveStream.Extensions\LiveStream.Extensions.csproj" />
    <ProjectReference Include="..\LiveStream.Native\LiveStream.Native.csproj" />
    <ProjectReference Include="..\LiveStream.Infrastructure\LiveStream.Infrastructure.csproj" />
  </ItemGroup>
  <Import Project="..\..\build\ObsRuntime.targets" />
</Project>
