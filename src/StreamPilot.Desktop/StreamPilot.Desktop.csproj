<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\StreamPilot.Application\StreamPilot.Application.csproj" />
    <ProjectReference Include="..\StreamPilot.Native\StreamPilot.Native.csproj" />
  </ItemGroup>
  <!-- Runtime de libobs + puente, producido por scripts/build-native.ps1. Opcional mientras no exista. -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\artifacts\obs-runtime')">
    <None Include="$(MSBuildThisFileDirectory)..\..\artifacts\obs-runtime\**\*" LinkBase="" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
