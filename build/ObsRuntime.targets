<Project>
  <!-- Copia el runtime de libobs + streampilot_bridge (producido por scripts/build-native.ps1) junto al ejecutable,
       conservando la estructura obs-plugins/64bit y data/. Opcional mientras el runtime no exista. -->
  <PropertyGroup>
    <ObsRuntimeDir>$(MSBuildThisFileDirectory)..\artifacts\obs-runtime\</ObsRuntimeDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(ObsRuntimeDir)streampilot_bridge.dll')">
    <None Include="$(ObsRuntimeDir)**\*"
          Link="%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>
</Project>
