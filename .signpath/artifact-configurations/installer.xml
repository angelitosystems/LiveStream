<?xml version="1.0" encoding="utf-8"?>
<!-- Configuración de artefacto «installer» de SignPath: el instalador LiveStream-Setup-<versión>.exe, ya con la
     aplicación firmada dentro. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="LiveStream-Setup-*.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
