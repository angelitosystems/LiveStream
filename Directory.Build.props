<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(OutputType)' == 'WinExe'">win-x64</RuntimeIdentifier>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Versión del producto: la usan el instalador, «Aplicaciones instaladas» y las actualizaciones. -->
    <Version>0.8.0</Version>
    <Product>LiveStream</Product>
    <Company>LiveStream</Company>
    <Copyright>© 2026 Angel Calderon Mantilla. GPL-2.0-or-later.</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <!-- Plataforma objetivo: Windows x64 (libobs + D3D11 + DPAPI). -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
